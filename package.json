{
  "name": "dwc-ng",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter @dwc-ng/ui dev",
    "build": "pnpm --filter @dwc-ng/ui build",
    "ship": "pnpm --filter @dwc-ng/deploy start",
    "preview": "pnpm --filter @dwc-ng/ui preview",
    "mock": "pnpm --filter @dwc-ng/mock-duet start",
    "mock:start": "node packages/mock-duet/src/mockctl.ts start",
    "mock:stop": "node packages/mock-duet/src/mockctl.ts stop",
    "mock:status": "node packages/mock-duet/src/mockctl.ts status",
    "mock:restart": "node packages/mock-duet/src/mockctl.ts restart",
    "mock:reap": "node packages/mock-duet/src/mockctl.ts reap",
    "test": "pnpm -r --if-present test && python scripts/register_check.py",
    "typecheck": "pnpm -r --if-present typecheck",
    "register:check": "python scripts/register_check.py",
    "register:check:fast": "python scripts/register_check.py --fast",
    "hooks:install": "git config core.hooksPath .githooks"
  }
}
